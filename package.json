{
  "name": "unitree_go2_webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI to control the Unitree Go2 robot dog over WebRTC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r44gh4v/unitree-go2-webui.git"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/crypto.test.mjs && node test/voxel.test.mjs && node test/signaling.test.mjs",
    "test:protocol": "vite --port 5174 --strictPort --open /test/protocol.html"
  },
  "dependencies": {
    "express": "^4.21.2",
    "js-md5": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5"
  }
}
